generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  password  String
  email     String   @unique
  username  String?
  createdAt DateTime @default(now())

  drivers     Driver?
  motorcycles Motorcycle[]
}

model Driver {
  id               Int      @id @default(autoincrement())
  driver_name      String
  photo            String?
  platform         String[]
  profit_goal      Int
  job_type         JOB_TYPE @default(FULL_TIME)
  avg_active_hours Int      @default(0)

  user    User @relation(fields: [user_id], references: [id])
  user_id Int  @unique
}

enum JOB_TYPE {
  FULL_TIME
  FREELANCE
  PART_TIME
}

model Motorcycle {
  id                Int               @id @default(autoincrement())
  brand             String
  model             String
  year              String
  transmission      TRANSMISSION_TYPE @default(MATIC)
  police_number     String
  kilometers        Int
  last_service_date DateTime?
  status            String?

  user    User @relation(fields: [user_id], references: [id])
  user_id Int  @unique
}

enum TRANSMISSION_TYPE {
  MATIC
  MANUAL
}
