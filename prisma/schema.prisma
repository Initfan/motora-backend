generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  password  String
  email     String   @unique
  username  String?
  createdAt DateTime @default(now())

  drivers Driver[]

  motorcycles Motorcycle[]

  workSessions WorkSession[]
}

model Driver {
  id               Int      @id @default(autoincrement())
  driver_name      String
  photo            String?
  platform         String[]
  profit_goal      Int
  job_type         JOB_TYPE @default(FULL_TIME)
  avg_active_hours Int      @default(0)

  user    User @relation(fields: [user_id], references: [id])
  user_id Int  @unique
}

enum JOB_TYPE {
  FULL_TIME
  FREELANCE
  PART_TIME
}

model Motorcycle {
  id                     Int               @id @default(autoincrement())
  brand                  String
  model                  String
  year                   String
  transmission           TRANSMISSION_TYPE @default(MATIC)
  police_number          String            @unique
  kilometers             Int
  avg_kilometers_per_day Int?              @default(0)
  last_service_date      DateTime?         @default(now())
  status                 String?

  user    User @relation(fields: [user_id], references: [id])
  user_id Int

  motorComponents MotorComponent[]

  fuelRecords FuelRecord[]
}

enum TRANSMISSION_TYPE {
  MATIC
  MANUAL
}

model WorkSession {
  id                Int        @id @default(autoincrement())
  kilometers_start  Float      @default(0)
  kilometers_finish Float      @default(0)
  platform          String
  goal_profit       Int
  fuel_condition    String
  total_order       Int        @default(0)
  status            WorkStatus @default(ACTIVE)
  started_at        DateTime   @default(now())
  finished_at       DateTime?
  created_at        DateTime   @default(now())

  user    User @relation(fields: [user_id], references: [id])
  user_id Int

  incomes  Income[]
  expenses Expense[]

  fuelRecords FuelRecord[]
}

enum WorkStatus {
  ACTIVE
  COMPLETED
}

model Income {
  id          Int         @id @default(autoincrement())
  income_type INCOME_TYPE
  amount      Int
  description String?
  created_at  DateTime    @default(now())

  work_session    WorkSession @relation(fields: [work_session_id], references: [id])
  work_session_id Int
}

enum INCOME_TYPE {
  ORDER
  BONUS
  TIP
  INCENTIVE
}

model Expense {
  id           Int          @id @default(autoincrement())
  expense_type EXPENSE_TYPE
  amount       Int
  description  String?
  created_at   DateTime     @default(now())

  work_session    WorkSession @relation(fields: [work_session_id], references: [id])
  work_session_id Int
}

enum EXPENSE_TYPE {
  FUEL
  PARKING
  TOLL
  OTHER
}

model MotorComponent {
  id                 Int             @id @default(autoincrement())
  last_service_date  DateTime
  last_service_km    Int
  next_schedule_date DateTime?
  next_schedule_km   Int?
  status             ComponentStatus @default(UNKNOWN)
  created_at         DateTime        @default(now())
  updated_at         DateTime        @default(now()) @updatedAt()

  component     MaintenanceComponent @relation(fields: [component_id], references: [id])
  component_id  Int
  motorcycle    Motorcycle           @relation(fields: [motorcycle_id], references: [id])
  motorcycle_id Int
}

enum ComponentStatus {
  SAFE
  DUE_SOON
  OVERDUE
  UNKNOWN
}

model MaintenanceComponent {
  id                     Int     @id @default(autoincrement())
  name                   String
  default_interval_km    Int
  default_interval_month Int
  is_critical            Boolean
  is_active              Boolean @default(true)

  motorComponents MotorComponent[]
}

model FuelRecord {
  id              Int      @id @default(autoincrement())
  odometer        Int
  fuel_type       String
  liters          Float
  total_price     Int
  price_per_liter Int
  full_tank       Boolean
  station         String   @default("Pertamina")
  filled_at       DateTime @default(now())

  work_session    WorkSession @relation(fields: [work_session_id], references: [id])
  work_session_id Int
  motorcycle      Motorcycle  @relation(fields: [motorcycle_id], references: [id])
  motorcycle_id   Int
}
