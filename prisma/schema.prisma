generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  password  String
  email     String   @unique
  username  String?
  createdAt DateTime @default(now())

  drivers Driver[]

  motorcycles Motorcycle[]

  workSessions WorkSession[]
}

model Driver {
  id               Int      @id @default(autoincrement())
  driver_name      String
  photo            String?
  platform         String[]
  profit_goal      Int
  job_type         JOB_TYPE @default(FULL_TIME)
  avg_active_hours Int      @default(0)

  user    User @relation(fields: [user_id], references: [id])
  user_id Int  @unique
}

enum JOB_TYPE {
  FULL_TIME
  FREELANCE
  PART_TIME
}

model Motorcycle {
  id                     Int               @id @default(autoincrement())
  brand                  String
  model                  String
  year                   String
  transmission           TRANSMISSION_TYPE @default(MATIC)
  police_number          String            @unique
  kilometers             Int
  avg_kilometers_per_day Int?              @default(0)
  last_service_date      DateTime?         @default(now())
  status                 String?

  user    User @relation(fields: [user_id], references: [id])
  user_id Int  @unique

  motorComponents MotorComponent[]
}

enum TRANSMISSION_TYPE {
  MATIC
  MANUAL
}

model WorkSession {
  id                Int        @id @default(autoincrement())
  kilometers_start  Float      @default(0)
  kilometers_finish Float      @default(0)
  platform          String
  goal_profit       Int
  fuel_condition    String
  total_order       Int        @default(0)
  status            WorkStatus @default(ACTIVE)
  created_at        DateTime   @default(now())

  user    User @relation(fields: [user_id], references: [id])
  user_id Int

  incomes Income?
}

enum WorkStatus {
  ACTIVE
  COMPLETED
}

model Income {
  id         Int @id @default(autoincrement())
  income     Int @default(0)
  net_income Int @default(0)
  bonus      Int @default(0)
  tip        Int @default(0)
  spending   Int @default(0)
  incentive  Int @default(0)

  work_session    WorkSession @relation(fields: [work_session_id], references: [id])
  work_session_id Int         @unique
}

model MotorComponent {
  id                 Int             @id @default(autoincrement())
  model              String
  component          String
  interval_km        Int
  interval_month     Int
  last_service_date  DateTime
  last_service_km    Int
  next_schedule_date DateTime?
  next_schedule_km   Int?
  status             ComponentStatus @default(UNKNOWN)

  motorcycle    Motorcycle @relation(fields: [motorcycle_id], references: [id])
  motorcycle_id Int
}

enum ComponentStatus {
  SAFE
  DUE_SOON
  OVERDUE
  UNKNOWN
}
